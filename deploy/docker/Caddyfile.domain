# ---------------------------------------------------------------------------
# hz.jundadt.com.cn 统一站点
#   /           Web 助手（frontend 产物，MES 页面 iframe 嵌入，故不设 X-Frame-Options）
#   /h5/        H5 助手（frontend-h5 产物，小程序 web-view 入口；产物 base 为相对路径，子路径可直挂）
#   /v1/        后端反代（两个前端生产构建 apiBase 均为空，同源 /v1/... 原样透传，不剥前缀）
# TLS 经 alidns DNS-01 自动签发，阿里云凭据由环境变量注入
#（ALIYUN_ACCESS_KEY_ID / ALIYUN_ACCESS_KEY_SECRET，见 compose.yaml）。
# 其余运行期变量：BACKEND_URL（后端地址）。
# ---------------------------------------------------------------------------

hz.jundadt.com.cn {
	tls {
		dns alidns {
			access_key_id {$ALIYUN_ACCESS_KEY_ID}
			access_key_secret {$ALIYUN_ACCESS_KEY_SECRET}
		}
	}

	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# ---- H5 助手（/h5/）----------------------------------------------------
	# handle 是互斥路由：/h5 精确命中重定向，/h5/* 才进静态站点
	handle /h5 {
		redir /h5/ 308
	}
	handle_path /h5/* {
		root * /srv/h5

		@h5Immutable path /assets/*
		header @h5Immutable Cache-Control "public, max-age=31536000, immutable"

		@h5Entry path /index.html
		header @h5Entry Cache-Control "no-cache, must-revalidate"

		try_files {path} /index.html
		file_server
	}

	# ---- 后端反代（Web / H5 共用同一约定：apiBase 置空，同源 /v1/...）----------
	# 原样透传到上游，绝不能剥前缀（剥了上游会 404）。
	handle /v1/* {
		reverse_proxy {$BACKEND_URL} {
			# SSE 流式关键：立即刷写，不攒缓冲
			flush_interval -1

			transport http {
				dial_timeout 10s
				# 问答推理可能持续数十秒，超时必须放宽
				read_timeout 600s
				write_timeout 600s
			}

			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# ---- Web 助手 SPA（/）---------------------------------------------------
	handle {
		root * /srv

		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@entry path /index.html
		header @entry Cache-Control "no-cache, must-revalidate"

		try_files {path} /index.html
		file_server
	}

	handle_errors {
		rewrite * /index.html
		file_server
	}
}
