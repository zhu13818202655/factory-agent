# Tracked template — copy to `.env` (git-ignored) and fill in real values.
#
# factory-agent reads ONLY process environment variables
# (pydantic-settings). They do not auto-load `.env`; VS Code debug configs load
# it via `envFile`, and shells can run: set -a; source .env; set +a
# Docker Compose reads the repo-root `.env` automatically.
# ---------------------------- LLM (one self-hosted Qwen for all 3 tiers) -----
# models.yaml references these via api_key_env / model_env / api_base_env, so
# retargeting the endpoint needs no edit to the tracked registry file.
# factory-fast / factory-reasoning / factory-summary all resolve here.
FACTORY_AGENT_LLM_API_BASE=http://117.184.148.14:21003/v1
FACTORY_AGENT_LLM_API_KEY=sk-your-key
FACTORY_AGENT_LLM_MODEL=Qwen/Qwen3.8-27B-FP8
# Optional DeepSeek v4 backup deployment (models.yaml priority-2 per alias).
# Leave empty to keep the registry Qwen-only (that deployment is skipped).
FACTORY_AGENT_LLM_KEY_DEEPSEEK=
# Thinking policy (global across aliases). Default OFF; when enabled the effort
# defaults to high. Values low/medium/high/max are mapped per provider:
#   Qwen (vLLM): low/medium/high only -> max treated as high
#   DeepSeek: low->low, medium->high, high->high, max->max
FACTORY_AGENT_LLM_THINKING_ENABLED=false
FACTORY_AGENT_LLM_THINKING_EFFORT=high
# Out-of-band endpoint health probing (ADR-0006). See ../../.env.example for
# semantics; this file is consumed by `docker compose config` during deployment.
FACTORY_AGENT_LLM_HEALTH_PROBE_INTERVAL_SECONDS=300
FACTORY_AGENT_LLM_HEALTH_PROBE_TIMEOUT_SECONDS=3.0
FACTORY_AGENT_LLM_HEALTH_PROBE_FAILURES_TO_DEMOTE=2

# ---------------------------- factory-agent ---------------------------------
FACTORY_AGENT_ENVIRONMENT=development
FACTORY_AGENT_HOST=127.0.0.1
FACTORY_AGENT_PORT=8000
FACTORY_AGENT_LOG_FORMAT=console
FACTORY_AGENT_LOG_LEVEL=INFO
# Customer MES root. Set = token gateway enabled (identity comes only from
# X-Factory-Credential).
FACTORY_AGENT_CANONICAL_MES_BASE_URL=http://hzlinkbiz.ywhzsoft.com:9002
FACTORY_AGENT_POSTGRES_URL=postgresql://factory_agent:factory_agent_dev@127.0.0.1:3432/factory_agent
FACTORY_AGENT_REDIS_URL=redis://localhost:6379/0
# strict = 对接期 (recommended while integrating with the customer environment)
FACTORY_AGENT_VALIDATION_MODE=strict

# ---------------------------- 导出产物对象存储（SeaweedFS）-------------------
# compose 内 agent-api 已把端点默认成 http://seaweedfs:8333（服务名互访）；
# 这三项同时被 seaweedfs 服务用作首次启动的凭据与桶名，**两处必须一致**。
# 留空 FACTORY_AGENT_S3_ENDPOINT_URL 即回退本地目录存储（EXPORT_STORE_DIR）。
FACTORY_AGENT_S3_ENDPOINT_URL=http://seaweedfs:8333
FACTORY_AGENT_S3_BUCKET=factory-agent-exports
FACTORY_AGENT_S3_ACCESS_KEY=factory_agent
FACTORY_AGENT_S3_SECRET_KEY=factory_agent_dev
# 导出产物保留期（秒），默认 90 天；到期后惰性清理
FACTORY_AGENT_EXPORT_RETENTION_SECONDS=7776000
# 宿主机访问 S3 的端口映射（仅回环）；aws-cli 调试与集成测试用
SEAWEEDFS_S3_PORT=8333

# ---------------------------- 平台统计面（/v1/statistics）-------------------
# 与 factory-agent 同一个进程、同一个库、同一个库用户；独立配置前缀。
# 三个密钥在生产必须换成随机长串（openssl rand -hex 32）。
# API token 同时是清库后引导首个运营账号的唯一通道，请单独保管。
FACTORY_AGENT_STATISTICS_API_TOKEN=dev-statistics-api-token
FACTORY_AGENT_STATISTICS_TOKEN_SIGNING_SECRET=dev-token-signing-secret-change-me
FACTORY_AGENT_STATISTICS_EXPORT_SIGNING_SECRET=dev-export-signing-secret-change-me
# 下载链接的对外基址：客户端能访问到的地址（不再是 8020）
FACTORY_AGENT_STATISTICS_DOWNLOAD_BASE_URL=http://127.0.0.1:8000
# 统计报表导出的落盘后端。端点非空 = 写对象存储（同一个 SeaweedFS 网关、
# 独立桶 factory-agent-statistics-exports，由上面的 S3_BUCKET 逗号列表一起
# 预建）；留空则回退 FACTORY_AGENT_STATISTICS_EXPORT_STORE_DIR 本地目录；
# 两者都空 = 内存后端（重启即丢）。
FACTORY_AGENT_STATISTICS_S3_ENDPOINT_URL=http://seaweedfs:8333
FACTORY_AGENT_STATISTICS_S3_BUCKET=factory-agent-statistics-exports
FACTORY_AGENT_STATISTICS_S3_ACCESS_KEY=factory_agent
FACTORY_AGENT_STATISTICS_S3_SECRET_KEY=factory_agent_dev
# 本地目录后端（仅当统计 S3 endpoint 留空时生效）
FACTORY_AGENT_STATISTICS_EXPORT_STORE_DIR=
# auto = 客户 MES 认可的 AppKey 首见即放行并登记；disabled 一律拒绝。
FACTORY_AGENT_STATISTICS_TENANT_REGISTRATION_MODE=auto
# usage_event 分区自动补建周期（秒）；0 = 只跑启动那一次
FACTORY_AGENT_USAGE_PARTITION_SWEEP_INTERVAL_SECONDS=86400
# 小时/日汇总（tenant_usage_*）重算周期（秒）；看板 KPI 全读它，0 = 只跑启动那一次
FACTORY_AGENT_USAGE_ROLLUP_SWEEP_INTERVAL_SECONDS=300
# 每次重算的回溯窗口（小时）；须明显大于上面的周期，兼作迟到事实的重放窗口
FACTORY_AGENT_USAGE_ROLLUP_WINDOW_HOURS=24
