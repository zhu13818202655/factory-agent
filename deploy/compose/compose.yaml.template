# =============================================================================
# factory-agent 生产 Compose 模板（全量配置 + 逐项注释）
# =============================================================================
# 这个文件的用途是「配置菜单」：把生产上可能要用到的开关都列全并解释清楚，
# 你按自己的部署形态删减，抄进你的真实 compose.yaml。
#
# 三种用法：
#   1) 只读参考：挑需要的段落抄进你的 compose.yaml
#   2) 整份使用：cp compose.yaml.template compose.yaml && 按需删段
#        cd deploy/compose && docker compose -f compose.yaml up -d --build --wait
#   3) 叠加覆盖（不动现有 compose.yaml）：
#        docker compose -f compose.yaml -f compose.yaml.template up -d
#
# 与本目录其它文件的关系：
#   compose.yaml            本地开发栈（PG/Redis + 两个服务），保持不动
#   middleware.yaml         只起 PG/Redis，供宿主机调试
#   compose.yaml.template   本文件：生产向全量配置，不参与 start.sh
#
# 变量取值：Compose 会自动读取 `.env`（从哪执行就读哪，通常放本目录或仓库根）。
# 本文件统一写成 ${VAR:-默认值}：.env 有就能覆盖，没配就用默认值。
# 生产必须显式配置的项标了 [必填]，没配会起不来或有功能不可用。
#
# ⚠️ 环境变量名陷阱（实测确认，pydantic-settings 按「前缀 + 字段名」精确匹配，
#    extra="ignore" 不会报错，写错名字是**静默失效**）：
#     ✓ FACTORY_AGENT_ENVIRONMENT    ✗ FACTORY_AGENT_ENV（被忽略）
#     ✓ USAGE_ADMIN_ENVIRONMENT      ✗ USAGE_ADMIN_ENV（被忽略）
#    后果：写错的话日志里每个条目的 environment 字段会一直是 development，
#    在 production 上无法用日志区分环境（ADR-0004 要求每条记录带 environment）。
# =============================================================================

name: factory-agent

# -----------------------------------------------------------------------------
# 日志策略（四个服务共用；改这一处即可）
# -----------------------------------------------------------------------------
# 关键设计：进程只把结构化日志写到 stdout，**落盘 / 轮转 / 保留期一律由这里
# 的日志驱动负责**（ADR-0004：容器内默认输出 JSON；审计事件 audit.<type> 走同
# 一条 stdout，见 observability/audit.py 的 StructuredLogAuditSink）。
#
# 落盘位置由 Docker 守护进程管理，每行一个 JSON：
#   {"log":"...\n","stream":"stdout","time":"2026-09-13T00:00:00.000000000Z"}
#   查实际路径： docker inspect -f '{{.LogPath}}' <容器名>
#   默认在 docker root 下：/var/lib/docker/containers/<容器ID>/<容器ID>-json.log
#   这些文件「专供守护进程访问」，不要手动改/删；采集器（Filebeat/Promtail/
#   Alloy）直接读这个目录是标准做法。
#
# json-file 驱动**只支持**这几个选项（别写别的）：
#   max-size（单文件上限，不设=不轮转）、max-file（历史文件数，仅在设了
#   max-size 时生效）、compress（轮转后压缩）、labels / labels-regex /
#   env / env-regex（把容器标签、环境变量带进日志行）
#
# 换其它驱动（按需二选一，driver 与 options 要配套）：
#   local   —— 更快、默认带压缩，选项与 json-file 相近；本地磁盘留存首选
#   syslog  —— options: syslog-address=udp://loghost:514, tag=factory-agent
#   fluentd —— options: fluentd-address=loghost:24224, fluentd-async=true
#   gelf    —— options: gelf-address=udp://loghost:12201
#   none    —— 不落盘（容器内也不留），仅在你已用 sidecar 采集时选
x-logging: &logging-json-file
  driver: json-file
  options:
    max-size: "50m" # [建议必填] 单文件到 50MB 就轮转；不设等于永不轮转，会写满盘
    max-file: "10" # 保留 10 个历史文件：50m x 10 ≈ 单容器 500MB 上限
    compress: "true" # 轮转后的旧文件 gzip，省盘
    # 想让日志行带上容器身份，便于采集端分流（按需打开）：
    # labels: "com.docker.compose.service"
    # env: "FACTORY_AGENT_ENVIRONMENT"

services:
  # ===========================================================================
  # 1/4 agent-api —— factory-agent 主服务（SSE 问答 + 即时导出）
  # ===========================================================================
  agent-api:
    build:
      context: ../..
      dockerfile: Dockerfile
      # Dockerfile 是 builder/runtime 两段；只取 runtime，不带 uv 与构建缓存
      target: runtime
    image: factory-agent:${FA_IMAGE_TAG:-production}

    # ---------------------- 进程与生命周期 ----------------------
    init: true # tini 当 PID 1：回收孤儿进程 + 正确转发 SIGTERM
    restart: unless-stopped # 异常退出自动拉起；人工 stop 后不再自动重启
    # SIGTERM 后留给进程收线的时间。SSE 是长连接，lifespan 里有 sweep/drain，
    # 给太短会打断正在跑的交互。建议 >= 你观测到的单次交互收尾时间。
    stop_grace_period: 30s

    # ---------------------- 运行环境 ----------------------
    environment:
      # --- 环境标识（进日志的 environment 字段；⚠️ 不是 _ENV）---
      FACTORY_AGENT_ENVIRONMENT: ${FACTORY_AGENT_ENVIRONMENT:-production}
      # 容器内必须监听 0.0.0.0，否则端口映射不通（默认 127.0.0.1 只适合宿主机跑）
      FACTORY_AGENT_HOST: 0.0.0.0
      # 注意：真正的监听端口由下面 command 里的 --port 决定，这里只是配置项
      FACTORY_AGENT_PORT: 8000

      # --- 日志（详细说明见文件顶部的 x-logging）---
      # [生产必须 json] console 格式会丢掉 extra 字段，审计事件的 payload 会全部
      # 不可见；json 才是「一行一个结构化对象」的格式
      FACTORY_AGENT_LOG_FORMAT: ${FACTORY_AGENT_LOG_FORMAT:-json}
      # DEBUG/INFO/WARNING/ERROR/CRITICAL。审计事件是 INFO 级，
      # 压到 WARNING 等于关掉审计输出 —— 生产不要高于 INFO
      FACTORY_AGENT_LOG_LEVEL: ${FACTORY_AGENT_LOG_LEVEL:-INFO}
      # 入站关联 ID 头名（api/server.py 用它读请求头并回写响应头）。
      # 前置网关已注入别的名字时改这里对齐
      FACTORY_AGENT_REQUEST_ID_HEADER: ${FACTORY_AGENT_REQUEST_ID_HEADER:-X-Request-ID}

      # --- 客户 MES（[必填]，缺了 readiness 会 degraded）---
      FACTORY_AGENT_CANONICAL_MES_BASE_URL: ${FACTORY_AGENT_CANONICAL_MES_BASE_URL:?请填写客户 MES 网关地址，例如 http://hzlinkbiz.ywhzsoft.com:9002}
      # 调用方把加密后的 app_key 放在这个头里，身份只从这里来
      FACTORY_AGENT_CREDENTIAL_HEADER: ${FACTORY_AGENT_CREDENTIAL_HEADER:-X-Factory-Credential}
      # accessToken 提前多少秒续期
      FACTORY_AGENT_MES_TOKEN_REFRESH_THRESHOLD_SECONDS: 300

      # --- 数据库 / 缓存 ---
      FACTORY_AGENT_POSTGRES_URL: ${FACTORY_AGENT_POSTGRES_URL:?请填写 factory_agent 库的 DSN}
      # Redis 只是缓存（非权威），丢了只影响速度不影响正确性。
      # ⚠️ 要关掉它请**整行删掉**：传空字符串会让 pydantic 校验失败（RedisDsn
      # 不接受空串），进程直接起不来 —— 实测确认，不是理论风险
      FACTORY_AGENT_REDIS_URL: ${FACTORY_AGENT_REDIS_URL:-redis://redis:6379/0}

      # --- 业务口径（对接期改动前先跟客户确认）---
      # strict = 对接期：范围不一致直接拦下并暴露成集成问题
      # production = 主路径信任 MES：exact 拦截+告警，heuristic 仅记日志
      FACTORY_AGENT_VALIDATION_MODE: ${FACTORY_AGENT_VALIDATION_MODE:-production}
      # 客户确认查询最多回溯一年
      FACTORY_AGENT_TIME_RANGE_MAX_DAYS: 366
      # 交期预警：阈值 = max(1, ceil(总工期 x 比例%))；缺订单开工日时用固定兜底天数
      FACTORY_AGENT_DELIVERY_WARNING_RATIO_PERCENT: 10
      FACTORY_AGENT_DELIVERY_WARNING_FALLBACK_DAYS: 7
      # 工时时区：影响「今天/本月」这类相对时间的解释
      FACTORY_AGENT_FACTORY_TIMEZONE: ${FACTORY_AGENT_FACTORY_TIMEZONE:-Asia/Shanghai}

      # --- 即时导出（服务端不留存：只在内存在有界缓冲里放一小会儿）---
      FACTORY_AGENT_EXPORT_BUFFER_TTL_SECONDS: 900 # 缓冲存活秒数（60~3600）
      FACTORY_AGENT_EXPORT_BUFFER_MAX_ENTRIES: 512 # 同时最多缓存多少个导出
      # 注意：导出下载是 fail-closed —— 审计事件写失败会直接 503 拒发

      # --- 会话/SSE 编排（动之前先读 config.py 的注释，几条互相牵制）---
      FACTORY_AGENT_SESSION_MAX_INPUT_CHARS: 2000
      FACTORY_AGENT_SESSION_MAX_CLARIFICATION_ROUNDS: 3
      FACTORY_AGENT_SESSION_HISTORY_MAX_TURNS: 8
      FACTORY_AGENT_SESSION_HISTORY_MAX_CHARS: 16384
      FACTORY_AGENT_SESSION_HEARTBEAT_SECONDS: 15 # SSE 心跳间隔，防止中间层掐连接
      FACTORY_AGENT_SESSION_FOLLOW_TIMEOUT_SECONDS: 600 # 跟随别人已 claim 的 run 的等待上限
      # 下面两条要一起看：run_timeout（单次执行预算）必须 < stale_running
      # （判定孤儿的时间），否则「活着但慢」的 run 会被当成孤儿误杀
      FACTORY_AGENT_SESSION_RUN_TIMEOUT_SECONDS: 300
      FACTORY_AGENT_SESSION_STALE_RUNNING_SECONDS: 600
      # 从未被任何连接 claim 的 pending：超时后由扫描判为 abandoned
      FACTORY_AGENT_SESSION_ABANDONED_PENDING_SECONDS: 600
      # 恢复扫描周期；0 = 关闭周期扫描（启动时那次仍然会跑）
      FACTORY_AGENT_SESSION_SWEEP_INTERVAL_SECONDS: 300

      # --- LLM（部署与 fallback 顺序在 models.yaml，这里只调开关）---
      # 逻辑别名：业务代码只认别名，改指向不动代码
      FACTORY_AGENT_LLM_FAST_ALIAS: factory-fast
      FACTORY_AGENT_LLM_REASONING_ALIAS: factory-reasoning
      FACTORY_AGENT_LLM_SUMMARY_ALIAS: factory-summary
      FACTORY_AGENT_LLM_TEMPERATURE: 0.0
      FACTORY_AGENT_LLM_TOP_P: 1.0
      FACTORY_AGENT_LLM_TIMEOUT_SECONDS: 30.0
      FACTORY_AGENT_LLM_MAX_OUTPUT_TOKENS: 2048
      FACTORY_AGENT_LLM_MAX_REPAIR_ATTEMPTS: 1 # JSON 解析失败后的补救次数（0~1）
      # 组内重试/冷却：连续 allowed_fails 次失败后该部署进 cooldown 冷却
      FACTORY_AGENT_LLM_NUM_RETRIES: 2
      FACTORY_AGENT_LLM_ALLOWED_FAILS: 2
      FACTORY_AGENT_LLM_COOLDOWN_SECONDS: 30
      # 思考模式开关（默认关）与强度 low/medium/high/max（按 provider 映射）
      FACTORY_AGENT_LLM_THINKING_ENABLED: "false"
      FACTORY_AGENT_LLM_THINKING_EFFORT: high
      # 注册表路径（镜像里已 COPY configs，一般不用改）
      FACTORY_AGENT_MODEL_REGISTRY_PATH: configs/knowledge/models.yaml
      # --- 下面四个不是 settings 字段：models.yaml 里按名字直接读 os.environ ---
      # api_key_env 引用的 key（留空则该部署被丢弃；全空 → registry 不可用，
      # 模型网关降级为 not_configured，问答会 fail fast）
      FACTORY_AGENT_LLM_API_KEY: ${FACTORY_AGENT_LLM_API_KEY:-}
      FACTORY_AGENT_LLM_KEY_DEEPSEEK: ${FACTORY_AGENT_LLM_KEY_DEEPSEEK:-}
      # model_env / api_base_env 引用的重定向值（留空则用 models.yaml 里的默认）
      FACTORY_AGENT_LLM_API_BASE: ${FACTORY_AGENT_LLM_API_BASE:-}
      FACTORY_AGENT_LLM_MODEL: ${FACTORY_AGENT_LLM_MODEL:-}

    # ---------------------- 启动命令 ----------------------
    # 先跑自己的 Alembic 迁移（幂等，版本表 alembic_version），失败即中止启动，
    # 不会带着错 schema 对外服务；exec 让 uvicorn 接管 PID 1 以正确收信号。
    command:
      - sh
      - -c
      - python -m factory_agent.persistence.migrations upgrade head
        && exec uvicorn factory_agent.api.server:create_app --factory --host 0.0.0.0 --port 8000
    # 想开多进程：给 uvicorn 加 --workers N（本服务无跨进程共享内存状态，
    # 因为日志走 stdout，多进程安全）。注意别同时改用「进程内写文件」方案。
    # command:
    #   - sh
    #   - -c
    #   - python -m factory_agent.persistence.migrations upgrade head
    #     && exec uvicorn factory_agent.api.server:create_app --factory
    #        --host 0.0.0.0 --port 8000 --workers 4

    # ---------------------- 端口暴露 ----------------------
    # 只在回环暴露，由宿主机的 Nginx/网关做 TLS 与转发；要对外直连再改成 0.0.0.0
    ports:
      - "127.0.0.1:${FACTORY_AGENT_PORT:-8000}:8000"

    # ---------------------- 文件系统 ----------------------
    # 只读根文件系统 + 只给 /tmp 一个可写 tmpfs：应用运行期不写业务文件
    # （导出是内存缓冲、无服务端留存），所以足够
    read_only: true
    tmpfs:
      - /tmp
    # 只有在决定「让进程自己写日志文件」时才需要挂卷（见文件末尾附录 B）：
    # volumes:
    #   - ./logs/agent-api:/var/log/factory-agent

    # 容器内用户。Dockerfile 已经是 USER app(uid 10001)，这里显式声明是为了
    # 提醒你：**挂出来的卷必须让 10001 可写**，否则进程启动即失败
    # user: "10001:10001"

    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true

    # ---------------------- 日志驱动 ----------------------
    # 展开写法（等价于顶部锚点，方便按服务微调；两者用其一，别重复配）
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "10"
        compress: "true"

    # ---------------------- 健康检查 ----------------------
    # 容器健康检查用 /live（只反映进程活着）。/ready 会返回各依赖的配置状态，
    # 注意它即使 degraded 也是 HTTP 200，所以做 K8s readinessProbe 时要么用
    # /live，要么让探针解析 body 里的 status 字段，不能只看状态码。
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=2)
      interval: 30s
      timeout: 3s
      retries: 3
      start_period: 20s # 冷启动要给迁移+目录加载留时间

    # ---------------------- 资源限制 ----------------------
    # Compose v2 在非 Swarm 模式下也会应用这里的 limits
    deploy:
      resources:
        limits:
          cpus: "2.0"
          memory: 2g
        reservations:
          cpus: "0.5"
          memory: 512m

    # ---------------------- 依赖 ----------------------
    # 用 condition 等中间件真的健康，而不是只等容器启动
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy

    networks:
      - factory-agent-net

  # ===========================================================================
  # 2/4 usage-admin —— 多租户用量聚合/运营 API（从不调用 MES）
  # ===========================================================================
  usage-admin:
    build:
      context: ../..
      dockerfile: usage-admin/Dockerfile
      target: runtime
    image: usage-admin:${UA_IMAGE_TAG:-production}
    init: true
    restart: unless-stopped
    environment:
      # ⚠️ 不是 USAGE_ADMIN_ENV（实测被忽略）
      USAGE_ADMIN_ENVIRONMENT: ${USAGE_ADMIN_ENVIRONMENT:-production}
      USAGE_ADMIN_HOST: 0.0.0.0
      USAGE_ADMIN_PORT: 8020
      # 与 factory-agent 共享同一个逻辑库，但用**自己的库用户**（表归属独占）
      USAGE_ADMIN_DATABASE_URL: ${USAGE_ADMIN_DATABASE_URL:?请填写 usage_admin 库用户的 DSN}
      # 前端凭证与三类签名密钥（生产必须换成随机长串，不要用示例值）
      USAGE_ADMIN_API_TOKEN: ${USAGE_ADMIN_API_TOKEN:?必填：前端 Bearer token}
      USAGE_ADMIN_TOKEN_SIGNING_SECRET: ${USAGE_ADMIN_TOKEN_SIGNING_SECRET:?必填：登录 token 签名密钥}
      USAGE_ADMIN_EXPORT_SIGNING_SECRET: ${USAGE_ADMIN_EXPORT_SIGNING_SECRET:?必填：导出下载链接签名密钥}
      # 导出下载链接的对外基址（客户端能访问到的地址，不是容器内地址）
      USAGE_ADMIN_DOWNLOAD_BASE_URL: ${USAGE_ADMIN_DOWNLOAD_BASE_URL:?必填：对外可访问的基址}
      USAGE_ADMIN_EXPORT_PRESIGN_EXPIRES_SECONDS: 900 # 预签名有效期（60~3600）
      USAGE_ADMIN_TIMEZONE_NAME: ${USAGE_ADMIN_TIMEZONE_NAME:-Asia/Shanghai}
      # 注意：usage-admin 没有 log_level/log_format 设置项，其日志固定走
      # stderr + loguru 默认格式（非 JSON、无脱敏），与 agent-api 的 JSON 不一致。
      # 两个服务一起落盘时，采集端需要分别解析。
    command:
      - sh
      - -c
      - python -m usage_admin.migrations upgrade head
        && exec uvicorn usage_admin.api.server:create_app --factory --host 0.0.0.0 --port 8020
    ports:
      - "127.0.0.1:${USAGE_ADMIN_PORT:-8020}:8020"
    read_only: true
    tmpfs:
      - /tmp
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true

    logging: *logging-json-file # 复用顶部锚点

    healthcheck:
      test:
        - CMD
        - python
        - -c
        - import urllib.request; urllib.request.urlopen('http://127.0.0.1:8020/health/live', timeout=2)
      interval: 30s
      timeout: 3s
      retries: 3
      start_period: 20s
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: 1g
        reservations:
          cpus: "0.25"
          memory: 256m
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - factory-agent-net

  # ===========================================================================
  # 3/4 PostgreSQL —— 共享逻辑库（FA 与 UA 各用各的用户、各自的版本表）
  # ===========================================================================
  # 生产上如果客户已有托管 PG（RDS 等），整段删掉，只把 POSTGRES_URL /
  # DATABASE_URL 指向它，并自己跑 `make migrate` 或一次性迁移 Job。
  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB: postgres
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?必填：postgres 超级用户密码}
    # 只在回环暴露：宿主机 psql 调试用；生产建议直接删掉 ports
    ports:
      - "127.0.0.1:${POSTGRES_PORT:-3432}:5432"
    volumes:
      - postgres-data:/var/lib/postgresql/data
      # 首次初始化时创建 factory_agent 库、两个业务用户、授权与默认权限
      - ./postgres/init-databases.sql:/docker-entrypoint-initdb.d/10-init-databases.sql:ro
    # 大导出/复杂查询多时把共享内存调大（默认 64MB 偏小）
    shm_size: 256mb
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U postgres -d postgres
      interval: 10s
      timeout: 3s
      retries: 10
      start_period: 10s
    logging: *logging-json-file
    networks:
      - factory-agent-net

  # ===========================================================================
  # 4/4 Redis —— 授权感知缓存（非权威：丢了只影响速度，不影响正确性）
  # ===========================================================================
  redis:
    image: redis:7-alpine
    restart: unless-stopped
    command:
      - redis-server
      - --appendonly
      - "yes" # 开 AOF：重启后缓存还能留着，减少冷启动抖动
      # - --maxmemory
      # - 256mb        # 需要时可以给缓存设上限，配 --maxmemory-policy allkeys-lru
    ports:
      - "127.0.0.1:${REDIS_PORT:-3379}:6379"
    volumes:
      - redis-data:/data
    healthcheck:
      test:
        - CMD
        - redis-cli
        - ping
      interval: 10s
      timeout: 3s
      retries: 10
    logging: *logging-json-file
    networks:
      - factory-agent-net

# -----------------------------------------------------------------------------
# 命名卷（数据落在这里；reset 会删卷，生产务必配好备份）
# -----------------------------------------------------------------------------
volumes:
  postgres-data: # PG 数据目录：唯一的权威业务数据，必须备份
  redis-data: # Redis AOF，可丢（缓存非权威）

# -----------------------------------------------------------------------------
# 网络：四个服务在同一私有网络上，靠服务名互访（postgres、redis）
# -----------------------------------------------------------------------------
networks:
  factory-agent-net:
    driver: bridge

# =============================================================================
# 附录 A：只抄单个服务时的内联日志写法
# =============================================================================
# 上面的 `logging: *logging-json-file` 依赖顶部锚点；如果你只把某一个服务抄到
# 自己的文件里，锚点会丢失（YAML 报 unknown anchor），换成内联：
#
#     logging:
#       driver: json-file
#       options:
#         max-size: "50m"
#         max-file: "10"
#         compress: "true"
#
# =============================================================================
# 附录 B：如果客户要求「日志必须由进程自己写文件」（本期未采用）
# =============================================================================
# 本期方案是「进程写 stdout，运行时落盘」，不需要改代码。若确实要走进程内写文件，
# 三件事必须一起做，缺一个就出问题：
#
# 1) 代码侧（约 20 行）
#    - src/factory_agent/config.py 加 log_dir / log_rotation / log_retention
#    - src/factory_agent/observability/logging_adapter.py::configure_logging
#      增加一个 loguru 文件 sink，且**必须复用 _build_json_sink**，否则脱敏失效
#    - usage-admin/src/usage_admin/logging.py 对称改造
# 2) 部署侧
#    - 上面两个服务的 volumes 里挂出目录（如 ./logs/agent-api:/var/log/factory-agent）
#    - 保证宿主机目录属主 = 容器内 uid 10001，否则 read_only + 权限双重拦截
#    - 日志轮转交给 loguru 的 rotation/retention（不要和 docker 驱动叠加）
# 3) 三个已知坑
#    - read_only: true 下除显式挂载卷与 tmpfs 外一律不可写
#    - 多进程（uvicorn --workers N）写同一文件 + rotation 有竞态，需按 pid 分文件
#    - 导出下载是 fail-closed：磁盘写失败会被当成审计写失败 → 503 拒发
#
# =============================================================================
# 生产上线前 checklist（本文件只留能靠配置解决的部分）
# =============================================================================
# [ ] 两个服务的 logging 段已配 max-size/max-file（否则磁盘会被写满）
# [ ] FACTORY_AGENT_ENVIRONMENT / USAGE_ADMIN_ENVIRONMENT 用的是正确变量名
# [ ] FACTORY_AGENT_LOG_FORMAT=json（console 会丢掉审计 payload）
# [ ] FACTORY_AGENT_LOG_LEVEL 不高于 INFO（否则审计事件不输出）
# [ ] 所有 :? 标记的 [必填] 项都在 .env 里配了
# [ ] TLS 在宿主网关终止；容器端口只绑 127.0.0.1
# [ ] postgres-data 卷有备份策略；PG 超级密码已换
# [ ] 探针用法确认：容器健康检查用 /health/live，/health/ready 仅作诊断
# [ ] 采集端已能解析两种格式（agent-api 是 JSON，usage-admin 是 loguru 默认文本）
