{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory-agent.local/schemas/story.schema.json",
  "title": "Factory Agent Story",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "epic",
    "status",
    "risk",
    "goal",
    "depends_on",
    "contracts",
    "acceptance",
    "non_goals",
    "human_decisions_required"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^STORY-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "epic": {"type": "string", "pattern": "^EPIC-[0-9]{3}$"},
    "status": {
      "enum": ["draft", "ready", "implementing", "review", "mergeable", "done", "blocked"]
    },
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "goal": {"type": "string", "minLength": 1},
    "depends_on": {
      "type": "array",
      "items": {"type": "string", "pattern": "^STORY-[0-9]{3}$"},
      "uniqueItems": true
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reads", "changes"],
      "properties": {
        "reads": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "changes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariants", "commands"],
      "properties": {
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "fixtures": {"type": "array", "items": {"type": "string"}},
        "performance": {"type": "object"}
      }
    },
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "human_decisions_required": {"type": "array", "items": {"type": "string"}}
  }
}
