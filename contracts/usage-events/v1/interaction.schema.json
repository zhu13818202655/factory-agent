{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory-agent.local/contracts/usage-events/v1/interaction.schema.json",
  "title": "Interaction usage events v1",
  "allOf": [
    {"$ref": "envelope.schema.json"},
    {
      "oneOf": [
        {
          "properties": {
            "event_type": {"const": "interaction_started"},
            "capability": {"type": ["string", "null"], "maxLength": 100},
            "entrypoint": {"enum": ["api", "web", "mobile"]},
            "role_category": {"enum": ["employee", "manager", "owner"]}
          },
          "required": ["event_type", "capability", "entrypoint", "role_category"]
        },
        {
          "properties": {
            "event_type": {"const": "interaction_completed"},
            "status": {"enum": ["completed", "failed", "cancelled", "rejected"]},
            "duration_ms": {"type": "integer", "minimum": 0},
            "mes_duration_ms": {"type": "integer", "minimum": 0},
            "llm_duration_ms": {"type": "integer", "minimum": 0},
            "local_duration_ms": {"type": "integer", "minimum": 0},
            "result_rows_bucket": {"enum": ["0", "1-10", "11-100", "101-1000", "1001+"]},
            "error_category": {"type": ["string", "null"], "maxLength": 64}
          },
          "required": [
            "event_type", "status", "duration_ms", "mes_duration_ms", "llm_duration_ms",
            "local_duration_ms", "result_rows_bucket", "error_category"
          ]
        }
      ]
    }
  ],
  "unevaluatedProperties": false
}
