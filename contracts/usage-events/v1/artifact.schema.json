{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory-agent.local/contracts/usage-events/v1/artifact.schema.json",
  "title": "Artifact usage events v1",
  "allOf": [
    {"$ref": "envelope.schema.json"},
    {
      "oneOf": [
        {
          "properties": {
            "event_type": {"const": "artifact_generated"},
            "format": {"enum": ["xlsx", "csv"]},
            "size_bucket": {"enum": ["0-10KiB", "10KiB-1MiB", "1MiB-10MiB", "10MiB+"]},
            "status": {"enum": ["completed", "failed"]}
          },
          "required": ["event_type", "format", "size_bucket", "status"]
        },
        {
          "properties": {
            "event_type": {"const": "artifact_downloaded"},
            "artifact_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "status": {"enum": ["completed", "failed", "expired"]}
          },
          "required": ["event_type", "artifact_id", "status"]
        }
      ]
    }
  ],
  "unevaluatedProperties": false
}
