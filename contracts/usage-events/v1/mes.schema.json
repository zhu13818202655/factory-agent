{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory-agent.local/contracts/usage-events/v1/mes.schema.json",
  "title": "MES usage event v1",
  "allOf": [
    {"$ref": "envelope.schema.json"},
    {
      "properties": {
        "event_type": {"const": "mes_call_completed"},
        "operation_id": {"type": "string", "pattern": "^[AC][0-9]+$"},
        "page_count": {"type": "integer", "minimum": 0},
        "row_count_bucket": {"enum": ["0", "1-10", "11-100", "101-1000", "1001+"]},
        "duration_ms": {"type": "integer", "minimum": 0},
        "status": {"enum": ["completed", "failed"]},
        "error_category": {"type": ["string", "null"], "maxLength": 64}
      },
      "required": [
        "event_type", "operation_id", "page_count", "row_count_bucket", "duration_ms", "status",
        "error_category"
      ]
    }
  ],
  "unevaluatedProperties": false
}
