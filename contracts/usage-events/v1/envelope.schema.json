{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory-agent.local/contracts/usage-events/v1/envelope.schema.json",
  "title": "Usage event envelope v1",
  "type": "object",
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "schema_version": {"const": "1.0"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "received_at": {"type": "string", "format": "date-time"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "user_subject_id": {"type": "string", "minLength": 32, "maxLength": 128},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "interaction_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "event_type": {"type": "string"}
  },
  "required": [
    "event_id",
    "schema_version",
    "occurred_at",
    "tenant_id",
    "user_subject_id",
    "session_id",
    "interaction_id",
    "trace_id",
    "event_type"
  ]
}
