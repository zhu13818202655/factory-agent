{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory-agent.local/contracts/usage-events/v1/llm.schema.json",
  "title": "LLM usage event v1",
  "allOf": [
    {"$ref": "envelope.schema.json"},
    {
      "properties": {
        "event_type": {"const": "llm_call_completed"},
        "logical_call_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "stage": {"type": "string", "minLength": 1, "maxLength": 64},
        "model_alias": {"type": "string", "minLength": 1, "maxLength": 100},
        "actual_model": {"type": "string", "minLength": 1, "maxLength": 200},
        "attempt": {"type": "integer", "minimum": 1},
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "cached_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0},
        "status": {"enum": ["completed", "failed"]},
        "fallback_reason": {"type": ["string", "null"], "maxLength": 64},
        "error_category": {"type": ["string", "null"], "maxLength": 64}
      },
      "required": [
        "event_type", "logical_call_id", "stage", "model_alias", "actual_model", "attempt",
        "prompt_tokens", "completion_tokens", "cached_tokens", "reasoning_tokens", "duration_ms",
        "status", "fallback_reason", "error_category"
      ]
    }
  ],
  "unevaluatedProperties": false
}
