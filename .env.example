FACTORY_AGENT_ENV=development
FACTORY_AGENT_HOST=0.0.0.0
FACTORY_AGENT_PORT=8000
MOCK_MES_HOST=0.0.0.0
MOCK_MES_PORT=8010
# Host-side database URLs. factory-agent and usage-admin SHARE one logical
# database `factory_agent` (ADR-0003 §7): separate users, exclusive table
# ownership, separate Alembic version tables (alembic_version /
# alembic_version_usage_admin). mock-mes keeps its own database. Docker Compose
# pins container-internal DSNs, so these host-side values never leak into the
# containers.
FACTORY_AGENT_POSTGRES_URL=postgresql://factory_agent:factory_agent_dev@127.0.0.1:3432/factory_agent
USAGE_ADMIN_DATABASE_URL=postgresql://usage_admin:usage_admin_dev@127.0.0.1:3432/factory_agent
REDIS_URL=redis://localhost:6379/0
# Model deployments and fallback order live in configs/knowledge/models.yaml (ADR-0006).
# Only the provider keys that registry names belong here.
FACTORY_AGENT_LLM_KEY_DEEPSEEK=

# --- mock-mes (Story 10): host-side URLs (Docker Compose pins its own
# container-internal DSN, so these never leak into the container). ---
MOCK_MES_DATABASE_URL=postgresql://mock_mes:mock_mes_dev@127.0.0.1:3432/mock_mes
MOCK_MES_TEST_DATABASE_URL=postgresql://mock_mes:mock_mes_dev@127.0.0.1:3432/mock_mes_test
