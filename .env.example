# Tracked template — copy to `.env` (git-ignored) and fill in real values.
#
# factory-agent / usage-admin read ONLY process environment variables
# (pydantic-settings). They do not auto-load `.env`; VS Code debug configs load
# it via `envFile`, and shells can run: set -a; source .env; set +a
# Docker Compose reads the repo-root `.env` automatically.

# ---------------------------- LLM (one self-hosted Qwen for all 3 tiers) -----
# models.yaml references these via api_key_env / model_env / api_base_env, so
# retargeting the endpoint needs no edit to the tracked registry file.
# factory-fast / factory-reasoning / factory-summary all resolve here.
FACTORY_AGENT_LLM_API_BASE=http://117.184.148.14:21003/v1
FACTORY_AGENT_LLM_API_KEY=sk-your-key
FACTORY_AGENT_LLM_MODEL=Qwen/Qwen3.8-27B-FP8
# Optional DeepSeek v4 backup deployment (models.yaml priority-2 per alias).
# Leave empty to keep the registry Qwen-only (that deployment is skipped).
FACTORY_AGENT_LLM_KEY_DEEPSEEK=
# Thinking policy (global across aliases). Default OFF; when enabled the effort
# defaults to high. Values low/medium/high/max are mapped per provider:
#   Qwen (vLLM): low/medium/high only -> max treated as high
#   DeepSeek: low->low, medium->high, high->high, max->max
FACTORY_AGENT_LLM_THINKING_ENABLED=false
FACTORY_AGENT_LLM_THINKING_EFFORT=high
# Out-of-band endpoint health probing (ADR-0006). Probes run once at startup
# and then every FACTORY_AGENT_LLM_HEALTH_PROBE_INTERVAL_SECONDS (0 = startup
# only). A failing probe demotes the offending endpoint behind its backup
# after FACTORY_AGENT_LLM_HEALTH_PROBE_FAILURES_TO_DEMOTE consecutive misses;
# a single success restores it. The reviewed registry itself is not edited.
FACTORY_AGENT_LLM_HEALTH_PROBE_INTERVAL_SECONDS=300
FACTORY_AGENT_LLM_HEALTH_PROBE_TIMEOUT_SECONDS=3.0
FACTORY_AGENT_LLM_HEALTH_PROBE_FAILURES_TO_DEMOTE=2

# ---------------------------- factory-agent ---------------------------------
FACTORY_AGENT_ENVIRONMENT=development
FACTORY_AGENT_HOST=127.0.0.1
FACTORY_AGENT_PORT=8000
FACTORY_AGENT_LOG_FORMAT=console
FACTORY_AGENT_LOG_LEVEL=INFO
# Customer MES root. Set = token gateway enabled (identity comes only from
# X-Factory-Credential).
FACTORY_AGENT_CANONICAL_MES_BASE_URL=http://hzlinkbiz.ywhzsoft.com:9002
FACTORY_AGENT_POSTGRES_URL=postgresql://factory_agent:factory_agent_dev@127.0.0.1:3432/factory_agent
FACTORY_AGENT_REDIS_URL=redis://localhost:6379/0
# 一致性校验 = advisory-only（2026-09-13 拍板「所见即所得」）：客户接口已按
# 权限过滤，异常只记录+告警+warning 日志，不拦截数据返回；此值仅作 finding
# 记录上的阶段标签（strict=对接期 / production=主路径）。
FACTORY_AGENT_VALIDATION_MODE=production
# MES 资源分页：首页用 PAGE_SIZE 探测 total；若按该 size 要超过 5 页，
# 自动调大到 PAGE_SIZE_MAX 以内并从第 1 页重取（整次取数只调一次）。
# 实测 2026-09-13：BarcodeClQuery 接受 size=10000（每页足量返回）；
# 8 月单月 total >5 万行，MAX_ROWS 必须盖过它，否则按「分页未完成」显式截断。
FACTORY_AGENT_MES_PAGE_SIZE=2000
FACTORY_AGENT_MES_PAGE_SIZE_MAX=50000
FACTORY_AGENT_MES_MAX_PAGES=20
FACTORY_AGENT_MES_MAX_ROWS=250000
# 导出产物：本地落盘保留（类网盘的本地实现，重启后仍可下载），过期惰性清理。
# 内存读缓存上限只影响 RAM，不影响落盘产物的可用性。
FACTORY_AGENT_EXPORT_STORE_DIR=data/exports
FACTORY_AGENT_EXPORT_RETENTION_SECONDS=604800
FACTORY_AGENT_EXPORT_BUFFER_MAX_ENTRIES=512


# ---------------------------- test frontend (tools/test_frontend) -----------
# Four per-user encrypted credentials issued by the customer MES (one per test
# user/role), read by the dev proxy at 127.0.0.1:8081 and by local probe
# scripts. These are NOT the tenant AppKey — the tenant AppKey comes back from
# /api/system/token and never needs configuring. Never ship real values here —
# put them in `.env`.
MES_USER_CREDENTIAL_00=
MES_USER_CREDENTIAL_01=
MES_USER_CREDENTIAL_02=
MES_USER_CREDENTIAL_99=
FA_FE_PORT=8081
FA_FE_UPSTREAM=http://127.0.0.1:8000

# ---------------------------- usage-admin -----------------------------------
USAGE_ADMIN_ENVIRONMENT=development
USAGE_ADMIN_HOST=127.0.0.1
USAGE_ADMIN_PORT=8020
USAGE_ADMIN_DATABASE_URL=postgresql://usage_admin:usage_admin_dev@127.0.0.1:3432/factory_agent
USAGE_ADMIN_API_TOKEN=dev-usage-admin-token
USAGE_ADMIN_TOKEN_SIGNING_SECRET=dev-token-signing-secret-change-me
USAGE_ADMIN_EXPORT_SIGNING_SECRET=dev-export-signing-secret-change-me
USAGE_ADMIN_DOWNLOAD_BASE_URL=http://127.0.0.1:8020
