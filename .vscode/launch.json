{
    // VS Code 调试配置（Factory Agent 联调用）
    //
    // 环境变量统一来自仓库根 .env（git-ignored），由 envFile 注入。
    // 注意：factory-agent 只读取进程环境变量，不会自己加载 .env，
    // 所以「不在 VS Code 里启动」时必须手动 set -a; source .env; set +a。
    //
    // 本地端口（互不冲突，可同时起）：
    //   8000  factory-agent API     FACTORY_AGENT_PORT
    //   8081  问答测试前端           FA_FE_PORT，上游默认 FA_FE_UPSTREAM=http://127.0.0.1:8000
    //   8082  统计与运营看板         UA_DEMO_PORT，上游默认 UA_DEMO_UPSTREAM=http://127.0.0.1:8000
    //   8095  MES 直连调试台         MES_CONSOLE_PORT，直连客户 MES，不经 API
    "version": "0.2.0",
    "configurations": [
        {
            // 不走 reload：uvicorn reload 会 fork 子进程，断点会失效。改代码请手动重启。
            "name": "factory-agent（客户真实 MES）",
            "consoleName": "FA-MES",
            "type": "debugpy",
            "request": "launch",
            "module": "factory_agent.__main__",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "console": "integratedTerminal",
            "purpose": [
                "debug-in-terminal"
            ]
        },
        {
            // 业务库与统计面同库，迁移只有这一条链（migrations/versions/ 下的单次 init）。
            "name": "factory-agent 迁移（upgrade head）",
            "consoleName": "FA-MIGRATE",
            "type": "debugpy",
            "request": "launch",
            "module": "factory_agent.persistence.migrations",
            "args": [
                "upgrade",
                "head"
            ],
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            // 平台审计过期行清理（一次性命令，外挂 cron）。分区维护不在这里，
            // 它跟着 API 的 lifespan 周期任务跑。
            "name": "factory-agent retention（清理过期审计）",
            "consoleName": "FA-RETENTION",
            "type": "debugpy",
            "request": "launch",
            "module": "factory_agent.cli",
            "args": [
                "retention"
            ],
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            // 直连客户 MES 接口调试台（不经 factory-agent）：左侧接口菜单 / 中间参数 /
            // 右侧格式化 JSON，自动换 token 并注入鉴权三参，结果可保存到 <仓库>/cache。
            // 启动后浏览器打开 http://127.0.0.1:8095（端口可用 MES_CONSOLE_PORT 覆盖）。
            "name": "MES 直连调试台（代理 + 页面）",
            "consoleName": "MES-Console",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/mes_console/server.py",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "factory-agent 测试前端（代理 + 静态页）",
            "consoleName": "FA-Demo",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/test_frontend/server.py",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            // 统计面（/v1/statistics）的演示看板：统计路由不带 CORS 且要求
            // Authorization: Bearer，所以由这个本地代理注入 token（不进浏览器）。
            "name": "统计与运营看板（代理 + 看板）",
            "consoleName": "STATS-Demo",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/usage_admin_demo/server.py",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true,
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            // 统计看板与问答台都要 API 在跑；MES 调试台独立，但一并起省得来回切。
            "name": "全部本地服务：API + 三个前端",
            "configurations": [
                "factory-agent（客户真实 MES）",
                "MES 直连调试台（代理 + 页面）",
                "factory-agent 测试前端（代理 + 静态页）",
                "统计与运营看板（代理 + 看板）"
            ],
            "stopAll": true
        }
    ]
}
