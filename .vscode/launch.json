{
    // VS Code 调试配置（Factory Agent 联调用）
    //
    // 环境变量统一来自仓库根 .env（git-ignored），由 envFile 注入：
    //   - 客户 MES 真实环境：FACTORY_AGENT_CANONICAL_MES_BASE_URL=http://hzlinkbiz.ywhzsoft.com:9002
    //   - 大模型：FACTORY_AGENT_LLM_API_BASE / _API_KEY / _MODEL
    // 注意：factory-agent 与 usage-admin 只读取进程环境变量，不会自己加载 .env，
    // 所以「不在 VS Code 里启动」时必须手动 set -a; source .env; set +a。
    "version": "0.2.0",
    "configurations": [
        {
            "name": "factory-agent（客户真实 MES）",
            "consoleName": "FA-MES",
            "type": "debugpy",
            "request": "launch",
            "module": "factory_agent.__main__",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "console": "integratedTerminal",
            // 不走 reload：uvicorn reload 会fork子进程，断点会失效。改代码请手动重启。
            "purpose": [
                "debug-in-terminal"
            ]
        },
        {
            "name": "usage-admin",
            "consoleName": "UA",
            "type": "debugpy",
            "request": "launch",
            "module": "usage_admin.__main__",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "pytest：当前文件",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-vv",
                "-s"
            ],
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "pytest：全量 unit",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/unit",
                "tests/eval",
                "usage-admin/tests/unit"
            ],
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "factory-agent-migrate（升级业务库）",
            "consoleName": "FA-MIGRATE",
            "type": "debugpy",
            "request": "launch",
            "module": "factory_agent.persistence.migrations",
            "args": [
                "upgrade",
                "head"
            ],
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "factory-agent 测试前端（代理 + 静态页）",
            "consoleName": "FA-Demo",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/test_frontend/server.py",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            // 直连客户 MES 接口调试台（不经 factory-agent）：左侧接口菜单 / 中间参数 /
            // 右侧格式化 JSON，自动换 token 并注入鉴权三参，结果可保存到 <仓库>/cache。
            // 启动后浏览器打开 http://127.0.0.1:8095（端口可用 MES_CONSOLE_PORT 覆盖）。
            "name": "MES 直连调试台（代理 + 页面）",
            "consoleName": "MES-Console",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/mes_console/server.py",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "usage-admin 演示前端（代理 + 看板）",
            "consoleName": "UA-Demo",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/usage_admin_demo/server.py",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "usage-admin-migrate（升级运营库）",
            "consoleName": "UA-MIGRATE",
            "type": "debugpy",
            "request": "launch",
            "module": "usage_admin.migrations",
            "args": [
                "upgrade",
                "head"
            ],
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            // 直连客户 MES 复现各类 incomplete_reason（不经 8000）。
            // envFile 注入 .env，等价于在终端先执行 set -a; source .env; set +a。
            "name": "复现 incomplete_reason（直连 MES）",
            "consoleName": "FA-REPRO",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/reproduce_incomplete.py",
            // 占位参数：--role 选 00/01/02/99；--section 选 all/pagination/metric/
            // reconciliation/upstream。需要换角色或只看某一节时直接改这里即可。
            "args": [
                "--role",
                "00",         // 00/01/02/99
                "--section",
                "pagination"  // all/pagination/metric/reconciliation/upstream
            ],
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "全部服务：factory-agent + usage-admin + 两个演示前端",
            "configurations": [
                "factory-agent（客户真实 MES）",
                "usage-admin",
                "factory-agent 测试前端（代理 + 静态页）",
                "usage-admin 演示前端（代理 + 看板）"
            ],
            "stopAll": true
        }
    ]
}
